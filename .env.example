# Discord application credentials and server (guild) ID
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Messages in this Discord channel are sent to Minecraft
CHAT_CHANNEL_ID=

# Comma-separated Discord user and/or role IDs allowed to control the server
CONTROL_USER_IDS=
CONTROL_ROLE_IDS=

# Crafty API. When both containers share a Docker network, "crafty" is the
# Crafty service/container name. Find the server UUID in its dashboard URL.
CRAFTY_URL=https://crafty:8443
CRAFTY_API_TOKEN=
CRAFTY_SERVER_ID=
# Crafty's default certificate is self-signed. Prefer a trusted certificate;
# set this to true only on a private Docker network if needed.
CRAFTY_ALLOW_SELF_SIGNED=false
